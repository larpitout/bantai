<?xml version="1.0" encoding="utf-8"?>
<!-- Babala card sa ibabaw ng kahit anong app. Disenyo: "SMS Gentle Banner" ng bantai_ui,
     pero mas malaki ang text at buttons para kay Nanay. -->
<!-- FrameLayout + padding: hindi sinusunod ng WindowManager ang layout_margin ng root. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_alert_card"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/warning_title"
            android:textColor="@color/caution_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAlertListen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_read_aloud"
            android:textColor="@color/bantai_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAlertAiBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/alert_ai_badge"
        android:textColor="@color/bantai_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAlertReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/bantai_text_muted"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvAlertAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/bantai_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAlertDismiss"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="center"
            android:text="@string/btn_dismiss"
            android:textColor="@color/bantai_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAlertCallApo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="@string/btn_call_apo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAlertTellApo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_secondary"
        android:gravity="center"
        android:minHeight="52dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/btn_tell_apo"
        android:textColor="@color/bantai_primary"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
</FrameLayout>
